<?xml version="1.0"?>
<ruleset name="WopCart Platform">
	<description>WordPress coding standards for the WopCart platform plugin. Deliberately the core plugin's ruleset with one prefix added, so a file that moves between the two needs no reformatting.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<rule ref="WordPress">
		<!--
			The plugin uses short array syntax nowhere and long syntax everywhere,
			which WordPress-Core already enforces. What it does not want enforced is
			Yoda conditions: the codebase reads comparisons left to right and relies
			on strict typing plus declare(strict_types=1) to catch assignment slips.
		-->
		<exclude name="WordPress.PHP.YodaConditions.NotYoda"/>

		<!--
			Filenames follow PSR-4 class names because the autoloader maps them
			directly. WordPress's own hyphenated-lowercase rule cannot apply to a
			PSR-4 tree.
		-->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wopcart-platform"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<!-- Hooks, options and cron events keep the core plugin's prefix: they are
					 the same product, and the platform's queue hook predates this plugin. -->
				<element value="wopcart"/>
				<element value="WopCart"/>
				<element value="WopCartPlatform"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.DeprecatedFunctions">
		<properties>
			<property name="minimum_wp_version" value="6.5"/>
		</properties>
	</rule>

	<config name="testVersion" value="8.2-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
